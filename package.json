{
  "name": "chatgpt-proxy",
  "version": "2.0.0",
  "description": "A proxy server for ChatGPT by The Open Data Institute",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "debug": "DEBUG=true node index.js"
  },
  "author": "The Open Data Institute",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "axios": "^1.5.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "morgan": "^1.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theodi/chargpt-proxy"
  },
  "engines": {
    "node": ">=14"
  },
  "env-cmd": {
    "development": {
      "ANTHROPIC_API_KEY": "your_anthropic_api_key",
      "ANTHROPIC_MODEL": "claude-sonnet-5-5",
      "MAX_COMPLETION_TOKENS": "4096",
      "EXPECTED_STARTS": "desired_start_string",
      "HOST": "localhost",
      "PORT": "3000",
      "SSL_KEY_PATH": "/path/to/your/keyfile.key",
      "SSL_PEM_PATH": "/path/to/your/pemfile.pem"
    }
  }
}
